<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Admin</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <%- include('partials/nav', { admin, active: 'dashboard' }) %>
  <%
    const k = analytics.kpis;
    const range = analytics.rangeDays;
    const delta = k.connections - k.previousConnections;
    const deltaPct = k.previousConnections > 0 ? Math.round((delta / k.previousConnections) * 100) : null;
    const authTotal = analytics.authMethods.reduce((sum, m) => sum + m.value, 0);
    const authShown = analytics.authMethods.filter((m) => m.value > 0);
    const seriesVars = ['--series-1', '--series-2', '--series-3'];
    const pct = (value, total) => total > 0 ? Math.round((value / total) * 100) + '%' : '0%';
    const hourLabel = (h) => String(h).padStart(2, '0') + ':00';
  %>

  <main class="admin-main dashboard-page">
    <div class="page-header">
      <div>
        <h1>Dashboard</h1>
        <p class="page-subtitle">Welcome back, <%= admin.username %></p>
      </div>
      <div class="header-actions">
        <span class="status-pill <%= controllerOnline ? 'is-online' : 'is-offline' %>">
          <span>Omada controller <%= controllerOnline ? 'online' : 'unreachable' %></span>
        </span>
        <nav class="segmented" aria-label="Date range">
          <% ranges.forEach((days) => { %>
            <a href="?range=<%= days %>" class="<%= days === range ? 'active' : '' %>"
               <%= days === range ? 'aria-current=page' : '' %>>Last <%= days %> days</a>
          <% }) %>
        </nav>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card stat-sessions">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
        </div>
        <div class="stat-value"><%= k.activeSessions.toLocaleString() %></div>
        <div class="stat-label">Connected now</div>
      </div>

      <div class="stat-card stat-trend">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div class="stat-value"><%= k.connections.toLocaleString() %></div>
        <div class="stat-label">Connections, last <%= range %> days</div>
        <div class="stat-delta">
          <% if (deltaPct === null) { %>
            <span>No connections in the previous <%= range %> days</span>
          <% } else { %>
            <span class="<%= delta >= 0 ? 'is-up' : 'is-down' %>"><%= delta >= 0 ? '▲' : '▼' %> <%= Math.abs(deltaPct) %>%</span>
            <span>vs previous <%= range %> days</span>
          <% } %>
        </div>
      </div>

      <div class="stat-card stat-rate">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="stat-value"><%= k.successRate === null ? '—' : Math.round(k.successRate * 100) + '%' %></div>
        <div class="stat-label">Sign-in success rate</div>
        <div class="stat-delta"><span><%= k.failedLogins.toLocaleString() %> failed attempt<%= k.failedLogins === 1 ? '' : 's' %></span></div>
      </div>

      <div class="stat-card stat-vouchers">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9a3 3 0 0 0 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 0 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>
        </div>
        <div class="stat-value"><%= k.unusedVouchers.toLocaleString() %></div>
        <div class="stat-label">Unused vouchers</div>
        <div class="stat-delta"><span>of <%= k.totalVouchers.toLocaleString() %> issued</span></div>
      </div>
    </div>

    <div class="dash-grid">
      <!-- Connections over time -->
      <section class="card span-2">
        <div class="card-head">
          <div>
            <h2>Connections over time</h2>
            <p class="card-sub">Guests authorized per day, with failed sign-in attempts</p>
          </div>
          <ul class="legend">
            <li><span class="swatch swatch-line" style="background: var(--series-1)"></span>Connections</li>
            <li><span class="swatch swatch-line" style="background: var(--series-2)"></span>Failed sign-ins</li>
          </ul>
        </div>
        <div class="chart" id="chart-daily" role="img"
             aria-label="Daily connections and failed sign-ins, last <%= range %> days"></div>
        <details class="table-view">
          <summary>View as table</summary>
          <table class="data-table">
            <thead><tr><th>Day</th><th>Connections</th><th>Failed sign-ins</th></tr></thead>
            <tbody>
              <% analytics.daily.labels.forEach((label, i) => { %>
                <tr><td><%= label %></td><td><%= analytics.daily.connections[i] %></td><td><%= analytics.daily.failed[i] %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </details>
      </section>

      <!-- Sign-in method -->
      <section class="card">
        <div class="card-head">
          <div>
            <h2>How guests sign in</h2>
            <p class="card-sub">Share of connections by method</p>
          </div>
        </div>
        <% if (authTotal === 0) { %>
          <div class="chart-empty">No connections in this period</div>
        <% } else if (authShown.length === 1) { %>
          <div class="single-share">
            <div class="stat-value">100%</div>
            <div class="stat-label">of <%= authTotal %> connection<%= authTotal === 1 ? '' : 's' %> used <strong><%= authShown[0].label %></strong></div>
          </div>
        <% } else { %>
          <div class="donut-wrap">
            <div class="chart" id="chart-auth" role="img" aria-label="Connections by sign-in method"></div>
            <ul class="donut-legend">
              <% authShown.forEach((m, i) => { %>
                <li>
                  <span class="swatch" style="background: var(<%= seriesVars[i] %>)"></span>
                  <%= m.label %>
                  <strong><%= m.value %></strong>
                  <small><%= pct(m.value, authTotal) %></small>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </section>

      <!-- Busiest hours -->
      <section class="card span-2">
        <div class="card-head">
          <div>
            <h2>Busiest hours</h2>
            <p class="card-sub">Connections by hour of day, last <%= range %> days</p>
          </div>
        </div>
        <div class="chart" id="chart-hourly" role="img" aria-label="Connections by hour of day"></div>
        <details class="table-view">
          <summary>View as table</summary>
          <table class="data-table">
            <thead><tr><th>Hour</th><th>Connections</th></tr></thead>
            <tbody>
              <% analytics.hourly.forEach((value, h) => { %>
                <tr><td><%= hourLabel(h) %>–<%= hourLabel((h + 1) % 24) %></td><td><%= value %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </details>
      </section>

      <!-- Voucher status -->
      <section class="card">
        <div class="card-head">
          <div>
            <h2>Vouchers</h2>
            <p class="card-sub">All issued vouchers by status</p>
          </div>
        </div>
        <% const voucherMax = Math.max(1, ...analytics.voucherStatus.map((v) => v.value)); %>
        <ul class="hbars">
          <% analytics.voucherStatus.forEach((v) => { %>
            <li class="hbar-row" title="<%= v.label %>: <%= v.value %>">
              <span class="hbar-label"><%= v.label %></span>
              <span class="hbar-track"><span class="hbar-fill" style="width: <%= (v.value / voucherMax) * 100 %>%; <%= v.value === 0 ? 'display:none' : '' %>"></span></span>
              <span class="hbar-value"><%= v.value %></span>
            </li>
          <% }) %>
        </ul>
      </section>

      <!-- Active sessions -->
      <section class="card span-2">
        <div class="card-head">
          <div>
            <h2>Connected now</h2>
            <p class="card-sub"><%= analytics.activeSessionList.length %> active session<%= analytics.activeSessionList.length === 1 ? '' : 's' %></p>
          </div>
          <a href="/admin/sessions" class="btn btn-sm">Manage sessions</a>
        </div>
        <table class="data-table">
          <thead>
            <tr><th>Client MAC</th><th>SSID</th><th>Band</th><th>Method</th><th>Started</th><th>Expires</th></tr>
          </thead>
          <tbody>
            <% analytics.activeSessionList.slice(0, 6).forEach((s) => { %>
              <tr>
                <td><code><%= s.clientMac %></code></td>
                <td><%= s.ssidName %></td>
                <td><%= s.band %></td>
                <td><%= s.authMethod %></td>
                <td><%= s.startedAt.toLocaleString() %></td>
                <td><%= s.expiresAt.toLocaleString() %></td>
              </tr>
            <% }) %>
            <% if (analytics.activeSessionList.length === 0) { %>
              <tr><td colspan="6" class="text-muted">Nobody is connected right now</td></tr>
            <% } %>
          </tbody>
        </table>
      </section>

      <!-- Wi-Fi band -->
      <section class="card">
        <div class="card-head">
          <div>
            <h2>Wi-Fi band</h2>
            <p class="card-sub">Connections by radio, last <%= range %> days</p>
          </div>
        </div>
        <% if (analytics.bands.length === 0) { %>
          <div class="chart-empty">No connections in this period</div>
        <% } else { %>
          <% const bandMax = Math.max(...analytics.bands.map((b) => b.value)); %>
          <ul class="hbars">
            <% analytics.bands.forEach((b) => { %>
              <li class="hbar-row" title="<%= b.label %>: <%= b.value %>">
                <span class="hbar-label"><%= b.label %></span>
                <span class="hbar-track"><span class="hbar-fill" style="width: <%= (b.value / bandMax) * 100 %>%"></span></span>
                <span class="hbar-value"><%= b.value %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <!-- Operating systems -->
      <section class="card">
        <div class="card-head">
          <div>
            <h2>Operating system</h2>
            <p class="card-sub">Guest devices, last <%= range %> days</p>
          </div>
        </div>
        <% if (analytics.osTypes.length === 0) { %>
          <div class="chart-empty">No connections in this period</div>
        <% } else { %>
          <% const osMax = Math.max(1, ...analytics.osTypes.map((item) => item.value)); %>
          <ul class="hbars">
            <% analytics.osTypes.forEach((item) => { %>
              <li class="hbar-row" title="<%= item.label %>: <%= item.value %>">
                <span class="hbar-label"><%= item.label %></span>
                <span class="hbar-track"><span class="hbar-fill" style="width: <%= (item.value / osMax) * 100 %>%"></span></span>
                <span class="hbar-value"><%= item.value %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <!-- Device types -->
      <section class="card">
        <div class="card-head">
          <div>
            <h2>Device type</h2>
            <p class="card-sub">Guest devices, last <%= range %> days</p>
          </div>
        </div>
        <% if (analytics.deviceTypes.length === 0) { %>
          <div class="chart-empty">No connections in this period</div>
        <% } else { %>
          <% const deviceMax = Math.max(1, ...analytics.deviceTypes.map((item) => item.value)); %>
          <ul class="hbars">
            <% analytics.deviceTypes.forEach((item) => { %>
              <li class="hbar-row" title="<%= item.label %>: <%= item.value %>">
                <span class="hbar-label"><%= item.label %></span>
                <span class="hbar-track"><span class="hbar-fill" style="width: <%= (item.value / deviceMax) * 100 %>%"></span></span>
                <span class="hbar-value"><%= item.value %></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <!-- Recent activity -->
      <section class="card span-3">
        <div class="card-head">
          <div>
            <h2>Recent activity</h2>
            <p class="card-sub">Latest audit events</p>
          </div>
          <a href="/admin/audit" class="btn btn-sm">Full audit log</a>
        </div>
        <table class="data-table">
          <thead>
            <tr><th>Time</th><th>Action</th><th>Details</th></tr>
          </thead>
          <tbody>
            <% recentActivity.forEach(log => { %>
              <tr>
                <td><%= log.timestamp.toLocaleString() %></td>
                <td>
                  <span class="badge badge-<%= log.success ? 'success' : 'error' %>">
                    <%= log.action.replace(/_/g, ' ') %>
                  </span>
                </td>
                <td><%= log.clientMac || log.ipAddress || '-' %></td>
              </tr>
            <% }) %>
            <% if (recentActivity.length === 0) { %>
              <tr><td colspan="3" class="text-muted">No activity yet</td></tr>
            <% } %>
          </tbody>
        </table>
      </section>
    </div>
  </main>

  <script type="application/json" id="dashboard-data"><%- JSON.stringify({
    daily: analytics.daily,
    hourly: analytics.hourly,
    authMethods: authShown,
  }).replace(/</g, '\\u003c') %></script>
  <script src="/js/dashboard-charts.js" defer></script>
</body>
</html>
