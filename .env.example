# =============================================================================
# Omada Guest Portal Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Port the portal server listens on (must match Omada controller config)
PORT=8080

# Node environment: development | production
NODE_ENV=development

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Session secret - generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_GENERATE_A_SECURE_SECRET

# -----------------------------------------------------------------------------
# Omada Controller
# -----------------------------------------------------------------------------
# Full URL to your Omada Controller (include port if non-standard)
# NOTE: If you move the controller to Proxmox, update to 192.168.1.30:8088
OMADA_CONTROLLER_URL=http://192.168.1.20:8088

# Site name as configured in the controller
OMADA_SITE_NAME=Malaika-House

# Hotspot Operator credentials (create in Controller → Settings → Authentication → Portal → Hotspot Manager → Operator)
OMADA_OPERATOR_USERNAME=
OMADA_OPERATOR_PASSWORD=

# -----------------------------------------------------------------------------
# Portal Behaviour
# -----------------------------------------------------------------------------
# Default session duration for guests (in minutes)
DEFAULT_SESSION_DURATION_MINUTES=60

# Guest SSID name (for validation)
GUEST_SSID=home-guest

# Timezone for audit logs and voucher expiry
TZ=Africa/Kigali

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite database path (inside container, maps to volume)
DATABASE_URL=file:/data/portal.db

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Rate limit: max login attempts per IP per window
RATE_LIMIT_MAX=10

# Rate limit window in minutes
RATE_LIMIT_WINDOW_MINUTES=15

# Trust proxy (set to 1 if behind reverse proxy)
TRUST_PROXY=0
